<Window x:Class="ClipboardApp.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Width="380" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Icon="pack://application:,,,/Assets/app.ico">
    <StackPanel Margin="24,20,24,20">

        <TextBlock Text="Clipboard shortcut: Ctrl+Shift+V" FontSize="13" FontWeight="SemiBold"
                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4"/>
        <TextBlock Text="Opens the history popup from anywhere." FontSize="11"
                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,18"/>

        <TextBlock Text="History size" FontSize="12" FontWeight="SemiBold"
                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
        <Grid Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="90"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Keep up to this many items" VerticalAlignment="Center" FontSize="13"
                       Foreground="{StaticResource TextPrimaryBrush}"/>
            <TextBox Grid.Column="1" x:Name="MaxEntriesBox" HorizontalContentAlignment="Center"
                     PreviewTextInput="MaxEntriesBox_PreviewTextInput"/>
        </Grid>

        <CheckBox x:Name="AutoPasteBox" Content="Auto-paste after selecting an item" Margin="0,0,0,10"/>
        <CheckBox x:Name="IgnorePasswordManagerBox" Content="Ignore copies from password managers" Margin="0,0,0,10"/>

        <CheckBox x:Name="AutoClearBox" Content="Auto-clear items older than" Margin="0,0,0,10"
                  Checked="AutoClearBox_Toggled" Unchecked="AutoClearBox_Toggled"/>
        <Grid Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="90"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Days to keep unpinned items" VerticalAlignment="Center" FontSize="13"
                       Foreground="{StaticResource TextPrimaryBrush}"/>
            <TextBox Grid.Column="1" x:Name="AutoClearDaysBox" HorizontalContentAlignment="Center"
                     PreviewTextInput="AutoClearDaysBox_PreviewTextInput"/>
        </Grid>

        <Border BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,1,0,0" Margin="0,0,0,18"/>

        <CheckBox x:Name="StartWithWindowsBox" Content="Start with Windows" Margin="0,0,0,10"/>
        <CheckBox x:Name="StartMinimizedBox" Content="Start minimized to tray" Margin="0,0,0,10"/>
        <CheckBox x:Name="MinimizeToTrayBox" Content="Minimize to tray" Margin="0,0,0,10"/>
        <CheckBox x:Name="CloseToTrayBox" Content="Close button minimizes to tray instead of exiting" Margin="0,0,0,20"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="Cancel_Click" IsCancel="True"/>
            <Button Content="Save" Style="{StaticResource PrimaryButton}" Click="Save_Click" IsDefault="True"/>
        </StackPanel>
    </StackPanel>
</Window>
